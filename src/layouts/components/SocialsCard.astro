---
import Card from "@components/Card.astro";
import Label from "@components/Label.astro";
import SocialAccount from "@components/SocialAccount.astro";

import Bluesky from "@icons/social/bluesky.svg";
import Discord from "@icons/social/discord.svg";
import Instagram from "@icons/social/instagram.svg";
import Email from "@icons/email.svg";
import GitHub from "@icons/social/github.svg";
import Mastodon from "@icons/social/mastodon.svg";
---

<Card class="socials">
    <Label class="label">Socials</Label>

    <div class="content">
        <SocialAccount url="https://instagram.com/nxcolas114">
            <Instagram /> @nxcolas114
        </SocialAccount>

        <SocialAccount url="https://github.com/jnslol">
            <GitHub /> @jnslol
        </SocialAccount>

        <SocialAccount url="https://discord.com/users/225541174008610816">
            <Discord /> @jns.lol
        </SocialAccount>

        <SocialAccount url="mailto:Juan <hello@jns.lol>">
            <Email /> hello@jns.lol
        </SocialAccount>
    </div>
</Card>

<style lang="scss">
    @media screen and (max-width: 970px) {
        .socials {
            width: min-content;
            align-self: center;
        }

        .content {
            display: flex;
            gap: 3em;
        }

        .label {
            display: none;
        }
	}

    @media screen and (max-width: 450px) {
        .socials {
            width: stretch;
        }

        .content {
            gap: 1.5em;
            justify-content: space-around;
        }
    }
</style>