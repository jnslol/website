---
import Card from "@components/Card.astro";
import InfoChip from "@components/InfoChip.astro";
import Label from "@components/Label.astro";

import JSIcon from "@icons/languages/javascript.svg"
import PythonIcon from "@icons/languages/python.svg"
import TSIcon from "@icons/languages/typescript.svg"

import VSCodeIcon from "@icons/software/vscode.svg"

import TanstackIcon from "@icons/libraries/tanstack.svg"
import AstroIcon from "@icons/libraries/astro.svg"
import NextIcon from "@icons/libraries/nextjs.svg"
---

<Card class="tools-card">
    <Label>IDEs</Label>
    <div class="tools">

        <InfoChip>
            <VSCodeIcon slot="icon"/> VSCode
        </InfoChip>
    </div>

    <Label>Languages</Label>
    <div class="tools">
        <InfoChip>
            <PythonIcon slot="icon"/> Python
        </InfoChip>

        <InfoChip>
            <TSIcon slot="icon"/> TypeScript
        </InfoChip>

        <InfoChip>
            <JSIcon slot="icon"/> JavaScript
        </InfoChip>
    </div>

    <Label>Frameworks</Label>
    <div class="tools">
        <InfoChip>
            <TanstackIcon slot="icon"/> Tanstack Start
        </InfoChip>

        <InfoChip>
            <AstroIcon slot="icon"/> Astro
        </InfoChip>

        <InfoChip>
            <NextIcon slot="icon"/> NextJS
        </InfoChip>
    </div>
</Card>

<style>
	.tools-card {
        gap: 1em;
    }

    .tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8em;
	}
</style>
