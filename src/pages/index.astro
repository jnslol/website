---

import InfoSection from './_components/InfoSection.astro';
import ToolListCard from './_components/ToolListCard.astro';
import NowPlayingCard from './_components/NowPlayingCard.astro';

import Card from '@components/Card.astro';
import Label from '@components/Label.astro';

import Default from '@layouts/Default.astro';
---

<Default title="jns | 🏠" description="15 year old developer.">
	<NowPlayingCard slot="sidebar" />

	<Card id="about">
		<Label>About</Label>

		<h1>Hello, I'm Juan</h1>
		I am a 15 year old Typescript developer as well as an okay-ish reverse engineer.
		
		<InfoSection />
	</Card>

	<ToolListCard />
</Default>
